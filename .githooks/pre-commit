#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

scripts/check_sources.sh

generated=(_includes/generated llms-ctx-full.txt)
if ! git diff --quiet -- "${generated[@]}"; then
  git add -- "${generated[@]}"
  echo "Updated and staged generated files"
fi
